rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to fetch the request user profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null && getUserData().role == 'ADMIN';
    }

    function isTeamOwner(teamId) {
      return request.auth != null && getUserData().role == 'TEAM' && getUserData().teamId == teamId;
    }

    // Users Collection
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Teams Collection
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Players Collection
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Auction State Collection
    match /auction/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && getUserData().role == 'TEAM');
    }

    // Transactions History Collection
    match /transactions/{txId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
