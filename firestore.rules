rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to fetch the request user profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null && getUserData().role == 'ADMIN';
    }

    function isTeamOwner(teamId) {
      return request.auth != null && getUserData().role == 'TEAM' && getUserData().teamId == teamId;
    }

    // Users Collection
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Teams Collection
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // Players Collection
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Auction State Collection
    match /auction/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (
        request.auth != null &&
        getUserData().role == 'TEAM' &&
        // Restrict modified fields to the exact fields updated by placeBid()
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentBid',
          'highestBidderTeamId',
          'highestBidderTeamName',
          'bidHistory',
          'updatedAt'
        ]) &&
        // Status, currentPlayerId, and startedAt must remain unchanged
        request.resource.data.status == resource.data.status &&
        request.resource.data.currentPlayerId == resource.data.currentPlayerId &&
        request.resource.data.startedAt == resource.data.startedAt &&
        // currentBid must strictly increase
        request.resource.data.currentBid > resource.data.currentBid &&
        // Bidder must be the authenticated team owner
        request.resource.data.highestBidderTeamId == getUserData().teamId &&
        // bidHistory remains a list and cannot be cleared.
        // NOTE: Because bidHistory is generated client-side, Firestore Rules 
        // do not perform full cryptographic validation of the complete history array contents.
        request.resource.data.bidHistory is list &&
        request.resource.data.bidHistory.size() > 0
      );
    }

    // Transactions History Collection
    match /transactions/{txId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Global Settings Collection
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
